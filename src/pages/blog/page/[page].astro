---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import ArticleListing from '~/components/blog/ArticleListing.astro';
import { getArticlePages } from '~/lib/articles';

export const getStaticPaths = (async () => {
    const pages = await getArticlePages();

    return pages.map(page => ({
        params: { page: String(page.currentPage) },
        props: page,
    }));
}) satisfies GetStaticPaths;

const page = Astro.props as InferGetStaticPropsType<typeof getStaticPaths>;
---

<ArticleListing {...page} />
