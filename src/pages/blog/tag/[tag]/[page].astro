---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import ArticleListing from '~/components/blog/ArticleListing.astro';
import { getTagPages } from '~/lib/articles';

export const getStaticPaths = (async () => {
    const pages = await getTagPages();

    return pages.map(({ tag, tagName, ...page }) => ({
        params: {
            tag,
            page: String(page.currentPage),
        },
        props: {
            ...page,
            tag: { slug: tag, name: tagName },
        },
    }));
}) satisfies GetStaticPaths;

const page = Astro.props as InferGetStaticPropsType<typeof getStaticPaths>;
---

<ArticleListing {...page} />
