---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import ArticleListing from '~/components/blog/ArticleListing.astro';
import { getTagPages } from '~/lib/articles';

export const getStaticPaths = (async () => {
    const firstPages = (await getTagPages()).filter(page => page.currentPage === 1);

    return firstPages.map(({ tag, tagName, ...page }) => ({
        params: { tag },
        props: {
            ...page,
            tag: { slug: tag, name: tagName },
        },
    }));
}) satisfies GetStaticPaths;

const page = Astro.props as InferGetStaticPropsType<typeof getStaticPaths>;
---

<ArticleListing {...page} />
