---
import { Image } from 'astro:assets';
import ModCard from '~/components/mods/ModCard.astro';
import CatalogHeader from '~/components/ui/CatalogHeader.astro';
import Section from '~/components/ui/Section.astro';
import BaseLayout from '~/layouts/Base.astro';
import { getModGroups } from '~/lib/mods';
import Routes from '~/lib/routes';
import { cssVariables } from '~/lib/styles';

const groups = await getModGroups();
---

<BaseLayout
  smallerHeader
  title={['Mods']}
  description="Game mods by Maciej Mieńko for Terraria, The Binding of Isaac, and Hogwarts Legacy."
>
  <div class="mods-page">
    <CatalogHeader
      title="Mods"
      color="var(--spark)"
      description="Small changes to games I play: different boss fights and help with a tricky broom trial."
      actions={[{ href: Routes.topics(), label: 'Browse all topics' }]}
    />
    <div class="mt-6 flex flex-col gap-8">
      {groups.map(group => <section id={group.id} class="scroll-mt-24" aria-labelledby={`game-${group.id}`} style={cssVariables({ '--mod-color': group.color })}>
        <Section data-page-reveal>
          <header class="game-heading relative isolate flex min-h-24 items-center justify-between gap-6 overflow-hidden p-6">
            <Image class="game-heading__image pointer-events-none absolute inset-y-0 right-0 -z-1 h-full w-2/3 object-cover" src={group.image} alt="" widths={[640, 960]} sizes="66vw" />
            <h2 class="text-2xl leading-tight" id={`game-${group.id}`}>{group.name}</h2>
            <span class="relative flex-none font-mono text-sm text-text-muted">{group.mods.length} {group.mods.length === 1 ? 'mod' : 'mods'}</span>
          </header>
        </Section>
        <div class="mt-4 grid grid-cols-2 gap-4 max-content:grid-cols-1">
          {group.mods.map(mod => <ModCard mod={mod} game={group} showGame={false} />)}
        </div>
      </section>)}
    </div>
  </div>
</BaseLayout>
