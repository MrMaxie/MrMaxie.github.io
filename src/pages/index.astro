---
import ArticleSummary from '~/components/blog/ArticleSummary.astro';
import BaseLayout from '~/layouts/Base.astro';
import { getArticles } from '~/lib/articles';
import { formatDate } from '~/lib/date';
import Routes from '~/lib/routes';

const lastArticles = (await getArticles()).slice(0, 3);
---

<BaseLayout>
    <h1>Latest articles</h1>
    {lastArticles.map(article => (
        <ArticleSummary
            title={article.data.title}
            date={formatDate(article.data.date)}
            tags={article.data.tags}
            description={article.data.description}
            href={Routes.article(article.id)}
        />
    ))}
    <a href={Routes.articles()} class="read-more">View all articles</a>
</BaseLayout>

<style>
.read-more {
    display: block;
    text-align: center;
    margin-top: 2rem;
}
</style>
