---
import { Icon } from 'astro-icon/components';
import BaseLayout from '~/layouts/Base.astro';
---

<BaseLayout title={['Not Found']} canonical="!remove">
    <div class="error-page">
        <Icon name="tabler:error-404" aria-hidden="true" />
        <h1>Not Found</h1>
        <p>Sorry, the page you are looking for does not exist.</p>
        <a href="/">Back to Home</a>
    </div>
</BaseLayout>

<style>
.error-page {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    flex: 1;
}

.error-page > :global(svg) {
    height: 10rem;
    width: 10rem;
    color: var(--text-dim);
    animation: bounce 5s infinite;
}

@keyframes bounce {
    0%,
    20%,
    50%,
    80%,
    100% {
        transform: translateY(0);
        color: var(--text);
    }

    40% {
        transform: translateY(-20px);
        color: var(--text-dim);
    }

    60% {
        transform: translateY(-10px);
        color: var(--text-dim);
    }
}

.error-page h1 {
    font-size: 2rem;
    margin-top: 1rem;
}

.error-page p {
    font-size: 1.2rem;
    color: var(--text-dim);
}
</style>
