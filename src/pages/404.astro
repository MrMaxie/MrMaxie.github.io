---
import { Icon } from 'astro-icon/components';
import ContentPanel from '~/components/ui/ContentPanel.astro';
import BaseLayout from '~/layouts/Base.astro';
---

<BaseLayout smallerHeader title={['Not Found']} canonical="!remove">
  <ContentPanel as="div" class="flex min-h-[55vh] flex-1 flex-col items-center justify-center p-6">
    <Icon class="size-16 text-accent-secondary" name="tabler:error-404" aria-hidden="true" />
    <h1 class="mt-2 max-w-[12ch] text-center text-detail-title leading-tight">That page is not here.</h1>
    <p class="mt-4 max-w-lg text-center text-base text-text-muted">
      The address may be wrong, or the page may have moved.
    </p>
    <a class="mt-3 border border-accent px-4 py-3 font-semibold text-text no-underline" href="/">Go home</a>
  </ContentPanel>
</BaseLayout>
