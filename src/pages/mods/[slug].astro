---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import ModSlideshow from '~/components/mods/ModSlideshow.astro';
import Description from '~/components/ui/Description.astro';
import ResourceHeader from '~/components/ui/ResourceHeader.astro';
import ResourceNavigation from '~/components/ui/ResourceNavigation.astro';
import BaseLayout from '~/layouts/Base.astro';
import { getGame, getMods } from '~/lib/mods';
import Routes from '~/lib/routes';
import { cssVariables } from '~/lib/styles';

export const getStaticPaths = (async () => {
  const resources = await getMods();
  return resources.map((resource, index) => ({
    params: { slug: resource.slug },
    props: { resource, previous: resources[index - 1], next: resources[index + 1] },
  }));
}) satisfies GetStaticPaths;
interface Props extends InferGetStaticPropsType<typeof getStaticPaths> {}
const { resource, previous, next } = Astro.props;
const game = getGame(resource.game);
---

<BaseLayout
  smallerHeader
  title={[resource.name, 'Mods']}
  description={resource.summary}
  crumbs={[{ label: 'Mods', href: Routes.mods() }, { label: resource.name }]}
>
  <article
    class="mod-detail flex flex-col gap-10"
    style={cssVariables({ '--project-color': game.color, '--mod-color': game.color })}
  >
    <ResourceHeader resource={resource} eyebrow={{ label: game.name, href: Routes.modGame(game.id) }} />
    {resource.screenshots.length > 0 && <ModSlideshow id={`mod-slideshow-${resource.slug}`} screenshots={resource.screenshots} />}
    <Description content={resource.description} />
    <ResourceNavigation title="More mods" previous={previous} next={next} />
  </article>
</BaseLayout>
