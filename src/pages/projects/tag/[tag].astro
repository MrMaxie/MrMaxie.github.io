---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';

import ProjectCard from '~/components/projects/ProjectCard.astro';
import CatalogHeader from '~/components/ui/CatalogHeader.astro';
import BaseLayout from '~/layouts/Base.astro';
import { getProjects } from '~/lib/projects';
import Routes from '~/lib/routes';
import { tagToSlug } from '~/lib/tags';

export const getStaticPaths = (async () => {
  const projects = await getProjects();
  const tagNames = new Map<string, string>();

  for (const project of projects) {
    for (const tag of project.tags) {
      tagNames.set(tagToSlug(tag), tag.name);
    }
  }

  return Array.from(tagNames, ([tag, tagName]) => ({
    params: { tag },
    props: {
      tagName,
      projects: projects.filter(project => project.tags.some(value => tagToSlug(value) === tag)),
    },
  }));
}) satisfies GetStaticPaths;

interface Props extends InferGetStaticPropsType<typeof getStaticPaths> {}
const { tagName, projects } = Astro.props;
---

<BaseLayout
  smallerHeader
  title={[`${tagName} projects`, 'Projects']}
  description={`Projects using or exploring ${tagName}, with their context, responsibility, and outcome.`}
  crumbs={[{ label: 'Projects', href: Routes.projects() }, { label: tagName }]}
>
  <div class="project-tag-page">
    <CatalogHeader
      eyebrow="Projects"
      title={tagName}
      description={`Projects using or exploring ${tagName}.`}
      count={`${projects.length} ${projects.length === 1 ? 'project' : 'projects'}`}
      actions={[{ href: Routes.topics(), label: 'Browse all topics' }]}
    />

    <section class="mt-4 grid grid-cols-2 gap-4 max-content:grid-cols-1" aria-label={`${tagName} projects`}>
      {projects.map(project => <ProjectCard project={project} />)}
    </section>
  </div>
</BaseLayout>
