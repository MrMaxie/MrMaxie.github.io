---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';

import { getProjects } from '~/lib/projects';
import Routes from '~/lib/routes';
import { tagToSlug } from '~/lib/tags';

export const getStaticPaths = (async () => {
  const projects = await getProjects();
  const tagNames = new Map<string, string>();

  for (const project of projects) {
    for (const tag of project.tags) {
      tagNames.set(tagToSlug(tag), tag.name);
    }
  }

  return Array.from(tagNames, ([tag, tagName]) => ({
    params: { tag },
    props: { tagName },
  }));
}) satisfies GetStaticPaths;

interface Props extends InferGetStaticPropsType<typeof getStaticPaths> {}
const { tagName } = Astro.props;
const tag = Astro.params.tag;
if (!tag) throw new Error('Missing project tag route parameter');
const destination = Routes.topic(tag);
const canonicalUrl = new URL(destination, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta http-equiv="refresh" content={`0;url=${canonicalUrl}`}>
    <link rel="canonical" href={canonicalUrl}>
    <title>{`Redirecting ${tagName} projects | Maxie.dev`}</title>
  </head>
  <body>
    <main>
      <h1>This page has moved</h1>
      <p>Continue to <a href={destination}>{tagName} projects and mods</a>.</p>
    </main>
  </body>
</html>
