---
import { Font } from 'astro:assets';
import { ClientRouter, fade } from 'astro:transitions';
import type { ComponentProps } from 'astro/types';

import '~/styles/global.css';

import Breadcrumbs from '~/components/site/Breadcrumbs.astro';
import ContactPanel from '~/components/site/ContactPanel.astro';
import Footer from '~/components/site/Footer.astro';
import Header from '~/components/site/Header.astro';
import Nav from '~/components/site/Nav.astro';
import { serializeStructuredData, siteStructuredData } from '~/lib/structured-data';

interface Props {
  title?: string[];
  smallerHeader?: boolean;
  description?: string;
  crumbs?: ComponentProps<typeof Breadcrumbs>['crumbs'];
  canonical?: string | '!default' | '!remove';
}

const { title = [], crumbs, description, smallerHeader = false, canonical = '!default' } = Astro.props;

let canonicalUrl: string | false = false;

switch (canonical) {
  case '!default':
    canonicalUrl = `${Astro.site}${Astro.url.pathname}`;
    break;
  case '!remove':
    canonicalUrl = false;
    break;
  default:
    canonicalUrl = `${Astro.site}${canonical}`;
    break;
}

if (canonicalUrl) {
  canonicalUrl = canonicalUrl.replace(/\/+/g, '/').replace(':/', '://');
}
const breadcrumbs = crumbs ? [{ label: 'Home', href: '/' }, ...crumbs] : [];
const pageTitle = [...title, 'Maciej Mieńko'].join(' | ');
const pageDescription = description ?? 'Software projects and game mods by Maciej Mieńko.';
const socialImage = new URL('/og-banner.png', Astro.site).href;
const socialImageAlt = 'Maciej Mieńko, software developer, with his portrait, maxie.dev and github.com/MrMaxie.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="description" content={pageDescription}>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" href="/favicon.ico" type="image/x-icon">
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16">
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32">
    <link rel="sitemap" href="/sitemap-index.xml">
    {canonicalUrl ? <link rel="canonical" href={canonicalUrl} /> : null}
    <title>{pageTitle}</title>
    {canonicalUrl && <>
      <meta property="og:type" content="website" />
      <meta property="og:site_name" content="Maciej Mieńko" />
      <meta property="og:title" content={pageTitle} />
      <meta property="og:description" content={pageDescription} />
      <meta property="og:url" content={canonicalUrl} />
      <meta property="og:image" content={socialImage} />
      <meta property="og:image:type" content="image/png" />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
      <meta property="og:image:alt" content={socialImageAlt} />
      <meta name="twitter:card" content="summary_large_image" />
      <meta name="twitter:title" content={pageTitle} />
      <meta name="twitter:description" content={pageDescription} />
      <meta name="twitter:image" content={socialImage} />
      <meta name="twitter:image:alt" content={socialImageAlt} />
    </>}
    {canonicalUrl && <script type="application/ld+json" set:html={serializeStructuredData(siteStructuredData(String(Astro.site), canonicalUrl, breadcrumbs))} />}
    <Font cssVariable="--font-outfit" preload />
    <Font cssVariable="--font-karla" preload />
    <Font cssVariable="--font-fira-code" preload={smallerHeader ? [{ subset: 'latin' }] : false} />
    <script is:inline>
    (() => {
      const storageKey = 'maxie-theme';
      let savedTheme = null;

      try {
        savedTheme = localStorage.getItem(storageKey);
      } catch {
        savedTheme = null;
      }

      const theme = savedTheme === 'light' || savedTheme === 'dark' ? savedTheme : 'dark';

      document.documentElement.dataset.theme = theme;
    })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <a
      class="fixed top-3 left-3 z-10 translate-y-[-200%] bg-text px-3 py-2 text-canvas focus:translate-y-0"
      href="#main-content"
      >Skip to content</a
    >
    <div class="flex min-h-dvh flex-col">
      <Nav />
      <div class="site-container flex flex-1 flex-col">
        <main
          id="main-content"
          class="main__content flex flex-1 flex-col gap-6 py-10 max-compact:py-6"
          transition:animate={fade({ duration: '0.16s' })}
        >
          <Header smaller={smallerHeader} />
          {crumbs && <Breadcrumbs crumbs={breadcrumbs} />}
          <slot />
          <ContactPanel />
        </main>
        <Footer />
      </div>
    </div>
    <script>
    import '~/scripts/site-motion';
    </script>
  </body>
</html>
