---
import Routes from '~/lib/routes';
import { tagToSlug } from '~/lib/tags';

interface Props {
    tags: string[];
}

const { tags } = Astro.props;
---

<div class="tags">
    {tags.map(tag => (
            <a class="tag" href={Routes.tag(tagToSlug(tag))}>
                {tag}
            </a>
        ))}
</div>

<style>
.tags {
    display: inline-flex;
    gap: 0.5rem;
}

.tags .tag {
    padding: 0.1rem 0.3rem;
    border-radius: 5px;
    background-color: var(--background-variant);
    font-size: 0.8rem;
    color: var(--text-dim);
    transition:
        background-color 0.3s,
        color 0.3s;
}

.tags .tag:hover {
    background-color: var(--text-accent);
    color: var(--background);
}
</style>
