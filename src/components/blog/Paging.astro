---
type Props = {
    id: string;
    currentPage: number;
    allPages: number;
    hrefTemplate: string;
};

const { id, currentPage, allPages, hrefTemplate } = Astro.props;

const links = Array.from({ length: allPages }, (_, index) => ({
    page: index + 1,
    isActive: index + 1 === currentPage,
    href: hrefTemplate.replace('{i}', String(index + 1)),
}));

const [prev, next] = [-1, 1].map(offset => {
    const page = currentPage + offset;

    return {
        page,
        isPossible: page > 0 && page <= allPages,
        href: hrefTemplate.replace('{i}', String(page)),
    };
});

const hidePaging = allPages <= 1;
---

{!hidePaging && (
        <nav>
            <a
                href={prev.isPossible ? prev.href : undefined}
                data-disabled={!prev.isPossible}
                transition:name={`paging-${id}-prev`}
            >
                ← Previous
            </a>
            <div class="pages">
                {links.map(({ page, isActive, href }) => (
                    <a
                        href={href}
                        data-disabled={isActive}
                        transition:name={`paging-${id}-${page}`}
                    >
                        {page}
                    </a>
                ))}
            </div>
            <a
                href={next.isPossible ? next.href : undefined}
                data-disabled={!next.isPossible}
                transition:name={`paging-${id}-next`}
            >
                Next →
            </a>
        </nav>
    )}

<style>
nav {
    display: flex;
    justify-content: center;
    align-items: center;
}

nav [data-disabled] {
    color: var(--text-dim);
    pointer-events: none;
}

nav .pages {
    flex: 1;
    display: flex;
    justify-content: center;
    gap: 0.5rem;
}

@media (max-width: 768px) {
    nav a {
        display: block;
        padding: 0.5rem 1rem;
        background: var(--background-variant);
    }

    nav a[data-disabled] {
        background: transparent;
    }
}
</style>
