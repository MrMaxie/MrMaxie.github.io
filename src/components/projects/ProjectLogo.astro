---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt?: string;
  class?: string;
  widths: number[];
  sizes: string;
}
const { src, alt = '', class: className, widths, sizes } = Astro.props;
---

<Image src={src} alt={alt} class={className} widths={widths} sizes={sizes} />
