---
import ModCard from '~/components/mods/ModCard.astro';
import ProjectCard from '~/components/projects/ProjectCard.astro';
import { getGame, type Mod } from '~/lib/mods';
import type { Project } from '~/lib/projects';
import Section from './Section.astro';

interface Props {
  previous?: Project | Mod;
  next?: Project | Mod;
  title: string;
}
const { previous, next, title } = Astro.props;
const neighbors = [
  { label: 'Previous', resource: previous },
  { label: 'Next', resource: next },
].flatMap(entry => (entry.resource ? [{ ...entry, resource: entry.resource }] : []));
---

{neighbors.length > 0 && <Section title={title} icon="tabler:arrows-left-right" id="resource-navigation">
  <div class:list={['resource-neighbors grid max-content:grid-cols-1', { 'grid-cols-2': neighbors.length === 2 }]}>
    {neighbors.map(({label, resource}) => <nav class="flex min-w-0 flex-col" aria-label={label}>
      {'game' in resource ? <ModCard mod={resource} game={getGame(resource.game)} showLinks={false} compact /> : <ProjectCard project={resource} variant="row" headingLevel="h3" showActions={false} />}
    </nav>)}
  </div>
</Section>}
