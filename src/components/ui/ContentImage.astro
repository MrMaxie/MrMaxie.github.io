---
import { Image } from 'astro:assets';

interface Props {
    alt: string;
    src: ImageMetadata;
    isRounded?: boolean;
    isCentered?: boolean;
    isFullWidth?: boolean;
    isBorderd?: boolean;
    width?: number;
    sub?: string;
}

const { alt, src, isRounded, isCentered, isFullWidth, isBorderd, width, sub } = Astro.props;
---

<div
    class:list={[
        'image-wrapper',
        {
            centered: isCentered,
            rounded: isRounded,
            'width-full': isFullWidth,
            bordered: isBorderd,
        },
    ]}
>
    <div class="image">
        <Image width={width} src={src} alt={alt} loading="eager" />
    </div>
    {sub && <div class="sub">{sub}</div>}
</div>

<style>
.image-wrapper {
    display: flex;
    align-items: center;
    flex-direction: column;
    margin-bottom: 1rem;
}

.image-wrapper .image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.image-wrapper.centered {
    justify-content: center;
}

.image-wrapper.rounded .image img {
    border-radius: 1rem;
}

.image-wrapper.width-full,
.image-wrapper.width-full .image {
    width: 100%;
}

.image-wrapper.bordered .image img {
    border: 1px solid rgba(255, 255, 255, 0.1);
}

.image-wrapper .sub {
    color: var(--text-dim);
    font-size: 0.8rem;
    margin-top: 0.5rem;
}
</style>
