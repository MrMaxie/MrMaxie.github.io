---
import { Image } from 'astro:assets';
import avatar from '~/assets/avatar.jpg';

type Props = {
    smaller?: boolean;
};

const { smaller = false } = Astro.props;
---

<section class:list={['header', { 'header--smaller': smaller }]} transition:name="header">
    <div class="name">Maciej (Maxie) Mieńko</div>
    <div class="sub">Professional overthinker with a keyboard</div>
    <Image
        class="avatar"
        src={avatar}
        alt=""
        width={160}
        height={160}
        format="webp"
        loading="eager"
        transition:name="header--avatar"
    />
</section>

<div class="separator"></div>

<style>
.header {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr auto;
    grid-template-rows: auto 1fr;
    grid-template-areas:
        "name avatar"
        "sub avatar";
}

@media (max-width: 768px) {
    .header {
        grid-template-areas:
            "name name"
            "sub avatar";
    }
}

.header .avatar {
    grid-area: avatar;
    aspect-ratio: 1 / 1;
    width: 10rem;
    height: 10rem;
    position: relative;
    border-radius: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 1;
    transition:
        opacity 0.3s,
        width 0.3s,
        height 0.3s;
    align-self: center;
}

@media (max-width: 768px) {
    .header .avatar {
        width: 7rem;
        height: 7rem;
    }
}

.header.header--smaller .avatar {
    width: 7rem;
    height: 7rem;
}

@media (max-width: 768px) {
    .header.header--smaller .avatar {
        width: 5rem;
        height: 5rem;
    }
}

.header .name {
    grid-area: name;
    font-size: 3rem;
    font-weight: bold;
}

@media (max-width: 768px) {
    .header .name {
        font-size: 2rem;
    }
}

.header .sub {
    grid-area: sub;
    color: var(--text-dim);
}

.separator {
    height: 1px;
    background-color: var(--background-variant);
}
</style>
