---
interface Props {
  crumbs: Array<{
    label: string;
    href?: string;
  }>;
}

const { crumbs = [] } = Astro.props;
---

<div class="breadcrumbs -mb-4 text-sm text-text-muted" transition:name="breadcrumbs">
  {crumbs.map(({ label, href }) =>
    href ? (
      <a
        class="text-text-muted no-underline after:mx-2 after:content-['/'] last:after:content-none hover:text-accent-hover"
        href={href}
      >
        {label}
      </a>
    ) : (
      <span class="after:mx-2 after:content-['/'] last:after:content-none">{label}</span>
    ),
  )}
</div>
