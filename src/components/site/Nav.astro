---
import { Icon } from 'astro-icon/components';
import Routes from '~/lib/routes';
---

<nav>
    <a href={Routes.about()}>About</a>
    <a href={Routes.articles()}>Articles</a>
    <a href="mailto:" data-contact-link aria-label="Email Link" class="icon-link">
        <Icon name="tabler:at" aria-hidden="true" />
    </a>
    <a href="https://github.com/MrMaxie" aria-label="Github Link" class="icon-link">
        <Icon name="tabler:brand-github" aria-hidden="true" />
    </a>
    <a
        href="https://www.linkedin.com/in/maciej-mie%C5%84ko-b0200b190/"
        aria-label="LinkedIn Link"
        class="icon-link"
    >
        <Icon name="tabler:brand-linkedin" aria-hidden="true" />
    </a>
</nav>

<script>
const contactAddress =
    '\u006d\u0069\u0065\u006e\u006b\u006f\u006d\u0061\u0063\u0069\u0065\u006a\u0040\u0067\u006d\u0061\u0069\u006c\u002e\u0063\u006f\u006d';

for (const contactLink of document.querySelectorAll<HTMLAnchorElement>('[data-contact-link]')) {
    contactLink.href = `mailto:${contactAddress}`;
}
</script>

<style>
nav {
    padding: 1rem;
    width: 100%;
    gap: 1.5rem;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: end;
    flex-wrap: wrap;
}

nav a {
    color: var(--text-dim);
    text-decoration: none;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.3s;
}

nav a.icon-link,
nav a[data-active="true"] {
    color: var(--text);
}

nav a:hover {
    color: var(--text-accent);
}
</style>
