---
import { getImage, Picture } from 'astro:assets';
import portrait from '~/assets/portrait.png';

interface Props {
  preload?: boolean;
}
const widths = [320, 368, 480, 560, 640, 736, 960, 1104];
const sizes =
  '(max-width: 21.5rem) calc(100vw - 1.5rem), (max-width: 48rem) 20rem, (max-width: 67.33rem) calc((100vw - 6rem) * 0.375), 23rem';
const preload = Astro.props.preload ? await getImage({ src: portrait, format: 'avif', widths, sizes }) : undefined;
---

{preload ? <link rel="preload" as="image" type="image/avif" imagesrcset={preload.srcSet.attribute} imagesizes={sizes} fetchpriority="high" /> :
<figure class="portrait relative m-0 aspect-square w-full">
  <Picture
    class="portrait__image block size-full object-contain"
    src={portrait}
    formats={['avif', 'webp']}
    alt="Portrait of Maciej Mieńko"
    widths={widths}
    sizes={sizes}
    loading="eager"
    fetchpriority="high"
  />
</figure>}
