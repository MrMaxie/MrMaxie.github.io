---
import { Icon } from 'astro-icon/components';

import { getCopyrightYearLabel } from '~/lib/metadata';

const copyrightYears = getCopyrightYearLabel();
---

<footer
  class="grid grid-cols-[1fr_auto] items-center gap-x-[clamp(1.25rem,4vw,2.5rem)] gap-y-4 border-t border-line pt-6.5 pb-9 text-sm text-text-muted max-footer:grid-cols-1"
>
  <p class="m-0">
    <span aria-hidden="true">©</span>
    <span>{copyrightYears}</span>
    Maciej Mieńko / Maxie
  </p>
  <nav class="flex flex-wrap items-center justify-end gap-5 max-footer:justify-start" aria-label="External links">
    <a
      class="inline-flex items-center gap-1.5 font-semibold text-text-muted no-underline hover:text-text"
      href="https://github.com/MrMaxie"
      target="_blank"
      rel="noopener"
    >
      <Icon class="size-4 stroke-link" name="tabler:brand-github" aria-hidden="true" />
      GitHub
    </a>
    <a
      class="inline-flex items-center gap-1.5 font-semibold text-text-muted no-underline hover:text-text"
      href="https://www.linkedin.com/in/maciej-mie%C5%84ko-b0200b190/"
      target="_blank"
      rel="noopener"
    >
      <Icon class="size-4 stroke-link" name="tabler:brand-linkedin" aria-hidden="true" />
      LinkedIn
    </a>
    <a
      class="inline-flex items-center gap-1.5 font-semibold text-text-muted no-underline hover:text-text"
      href="https://ko-fi.com/MrMaxie"
      target="_blank"
      rel="noopener"
    >
      <Icon class="size-4 stroke-link" name="tabler:coffee" aria-hidden="true" />
      Ko-fi
    </a>
    <a
      class="inline-flex items-center gap-1.5 font-semibold text-text-muted no-underline hover:text-text"
      href="https://github.com/sponsors/MrMaxie"
      target="_blank"
      rel="noopener"
    >
      <Icon class="size-4 stroke-link" name="tabler:heart" aria-hidden="true" />
      GitHub Sponsors
    </a>
  </nav>
</footer>
