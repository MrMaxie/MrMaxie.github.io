{
    "name": "mrmaxie.github.io",
    "private": true,
    "type": "module",
    "version": "2.0.0",
    "scripts": {
        "dev": "astro dev",
        "preview": "astro preview",
        "format": "biome check --write .",
        "check": "biome check .",
        "check:astro": "astro check",
        "test": "node --test --experimental-strip-types tests/*.test.ts",
        "build": "astro build",
        "openspec:validate": "openspec schema validate arcantry && openspec validate --all --strict --no-interactive"
    },
    "dependencies": {
        "@astrojs/mdx": "7.0.6",
        "@astrojs/sitemap": "3.7.3",
        "@fontsource-variable/fira-code": "5.3.0",
        "@fontsource-variable/karla": "5.3.0",
        "@iconify-json/tabler": "1.2.38",
        "@playform/compress": "0.2.5",
        "astro": "7.2.3",
        "astro-icon": "1.2.0"
    },
    "devEngines": {
        "packageManager": {
            "name": "nub",
            "version": "0.7.5",
            "onFail": "ignore"
        }
    },
    "devDependencies": {
        "@astrojs/check": "0.9.10",
        "@biomejs/biome": "2.5.9",
        "@fission-ai/openspec": "1.9.0",
        "@types/node": "24.13.3",
        "sharp": "0.35.3",
        "typescript": "6.0.3"
    },
    "allowBuilds": {
        "esbuild": true,
        "sharp": true,
        "@fission-ai/openspec": false
    }
}
